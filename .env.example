# ============================================================
# AI VOICE RECEPTIONIST — Environment Variables
# Copy this to .env.local for local development
# ============================================================

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ── Backend API (Node.js) ────────────────────────────────────
# Set this to your Railway/Render backend URL in production
# NEXT_PUBLIC_API_URL=https://api.yourapp.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.yourapp.com

# ── Twilio ──────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── Inworld AI ──────────────────────────────────────────────
# INWORLD_API_KEY=<your-inworld-api-key>
# INWORLD_WORKSPACE=<your-workspace-name>

# ── Deepgram STT ────────────────────────────────────────────
# DEEPGRAM_API_KEY=<your-deepgram-api-key>

# ── ElevenLabs TTS ──────────────────────────────────────────
# ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
# ELEVENLABS_VOICE_ID=<default-voice-id>

# ── MongoDB ─────────────────────────────────────────────────
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai-voice-receptionist

# ── JWT Auth ────────────────────────────────────────────────
# JWT_SECRET=<256-bit-random-secret>
# JWT_REFRESH_SECRET=<another-256-bit-secret>

# ── Stripe Billing ──────────────────────────────────────────
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxx
# STRIPE_SECRET_KEY=sk_live_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ── AWS S3 (recordings) ─────────────────────────────────────
# AWS_ACCESS_KEY_ID=<key>
# AWS_SECRET_ACCESS_KEY=<secret>
# AWS_S3_BUCKET=ai-voice-recordings
# AWS_REGION=us-east-1
